# Email Service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Crisp Chat
NEXT_PUBLIC_CRISP_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Calendly
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-business

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Site URL
NEXT_PUBLIC_SITE_URL=https://ocappliancerepair.com

# Where contact form submissions are delivered.
# RESEND_API_KEY is required — without it the form returns an error telling
# the visitor to call, rather than pretending the message was sent.
CONTACT_TO_EMAIL=appliance@coastpro.us
# Must be a domain verified in Resend.
CONTACT_FROM_EMAIL=CoastPro Website <noreply@coastpro.us>
