# =============================================================================
# CoastPro — environment
#
# Everything below is optional except DATABASE_URL, ADMIN_PASSWORD and
# ADMIN_SESSION_SECRET. Anything unset degrades quietly: the site keeps working
# and the console tells you what is missing on its Settings screen.
# =============================================================================

# --- Required -----------------------------------------------------------------

# Railway → the Postgres service → Variables → DATABASE_PUBLIC_URL.
#
# It must be the PUBLIC one. Railway's own DATABASE_URL points at
# *.railway.internal, which resolves only inside Railway's private network —
# this site runs on Vercel, so it would never connect.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

# The single password for /admin.
ADMIN_PASSWORD=

# Signs the admin session cookie. Any random string of 32+ characters.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Strongly recommended -----------------------------------------------------

# Salts the hash of visitor IP addresses. Change it and unique-visitor counts
# restart, so set it once and leave it.
ANALYTICS_IP_SALT=

# Where lead notifications go. Without a key the form tells the visitor to call
# instead of pretending the message was sent — the lead is still recorded.
RESEND_API_KEY=
CONTACT_TO_EMAIL=appliance@coastpro.us
CONTACT_FROM_EMAIL=CoastPro Website <noreply@coastpro.us>

NEXT_PUBLIC_SITE_URL=https://coastpro.us

# The shop's own timezone — every day boundary and hour-of-day chart uses it.
NEXT_PUBLIC_SHOP_TIMEZONE=America/Los_Angeles

# --- Bookings (JobPocket) -----------------------------------------------------

# Whose calendar the booking form reads. This is the only genuinely per-site
# value here, so it stays an environment variable.
JOBPOCKET_BOOKING_SLUG=coastpro

# Where JobPocket lives. Leave unset in production — the default is correct.
JOBPOCKET_API_BASE=

# The plugin key that lets this site file leads and read back their outcome.
# Normally NOT set here: it belongs in the `settings` table, pasted from
# JobPocket's builder screen, because the key rotates and a rotation would
# otherwise need a redeploy before the forms worked again. Set it only for
# local work — the environment wins over the table when present.
JOBPOCKET_API_KEY=

# --- Call tracking (Telnyx) ---------------------------------------------------

# Telnyx portal → Account → Keys → Public Key. Verifies the call webhook.
TELNYX_PUBLIC_KEY=
# Alternative to the public key while testing: append ?token=... to the webhook
# URL and put the same value here.
TELNYX_WEBHOOK_TOKEN=

# --- Reporting conversions back to the ad platforms ---------------------------

# Google Ads offline conversion import. The conversion action must be created in
# Google Ads first, with "Import → from clicks".
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CONVERSION_ACTION_ID=

# Meta Conversions API — Events Manager → Settings → Generate access token.
META_PIXEL_ID=
META_CAPI_TOKEN=

# --- Scheduled jobs -----------------------------------------------------------

# Protects /api/cron/conversions. Vercel sends it as a bearer token
# automatically once the variable exists.
CRON_SECRET=

# --- Existing integrations ----------------------------------------------------

NEXT_PUBLIC_CRISP_WEBSITE_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-W9Q0EMD7Q5

# ---------------------------------------------------------------------------
# Presence — the listings and profiles the business appears on
#
# Google Business Profile. Separate OAuth credentials from the Google Ads ones
# above: this needs the business.manage scope, and sharing a refresh token
# between them means one revocation takes out both. The Business Profile APIs
# also need enabling on a Cloud project and an access request approved by
# Google, which has historically taken days to weeks — until then the importer
# reports "not configured" and writes nothing.
#
# GBP_LOCATION_ID is the numeric id, with or without the `locations/` prefix.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_LOCATION_ID=

# Meta — Instagram and Facebook insights, from one Page token.
#
# META_PAGE_TOKEN is a long-lived Page access token; it lapses after about
# sixty days unless refreshed, and when it does the importer says so rather
# than recording zeroes. META_IG_USER_ID is the Instagram professional account
# linked to that Page. Either id may be left blank to skip that network.
META_PAGE_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# Yelp and Apple Business Connect have no API a single location can use — their
# numbers are typed into /admin/presence by hand. Nothing to configure.
