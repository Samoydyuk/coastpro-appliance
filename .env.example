# =============================================================================
# CoastPro — environment
#
# Everything below is optional except DATABASE_URL, ADMIN_PASSWORD and
# ADMIN_SESSION_SECRET. Anything unset degrades quietly: the site keeps working
# and the console tells you what is missing on its Settings screen.
# =============================================================================

# --- Required -----------------------------------------------------------------

# Railway → the Postgres service → Variables → DATABASE_PUBLIC_URL.
#
# It must be the PUBLIC one. Railway's own DATABASE_URL points at
# *.railway.internal, which resolves only inside Railway's private network —
# this site runs on Vercel, so it would never connect.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

# The single password for /admin.
ADMIN_PASSWORD=

# Signs the admin session cookie. Any random string of 32+ characters.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Strongly recommended -----------------------------------------------------

# Salts the hash of visitor IP addresses. Change it and unique-visitor counts
# restart, so set it once and leave it.
ANALYTICS_IP_SALT=

# Where lead notifications go. Without a key the form tells the visitor to call
# instead of pretending the message was sent — the lead is still recorded.
RESEND_API_KEY=
CONTACT_TO_EMAIL=appliance@coastpro.us
CONTACT_FROM_EMAIL=CoastPro Website <noreply@coastpro.us>

NEXT_PUBLIC_SITE_URL=https://coastpro.us

# The shop's own timezone — every day boundary and hour-of-day chart uses it.
NEXT_PUBLIC_SHOP_TIMEZONE=America/Los_Angeles

# --- Console security ---------------------------------------------------------

# Seals the JobPocket keys held in the `settings` table. Without it the console
# refuses to store a key at all, because a plugin key sitting in plain text in
# every backup is not a thing to do quietly.
#   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# The second factor for signing in. While this is empty the password alone gets
# you in and the Settings screen says so in red; set it and the six-digit code
# becomes required on the very next request, with no redeploy.
#   Generated during setup — scan the otpauth:// URI into an authenticator app
#   BEFORE setting this, or you will lock yourself out.
ADMIN_TOTP_SECRET=

# --- Bookings (JobPocket) -----------------------------------------------------

# Whose calendar the booking form reads. This is the only genuinely per-site
# value here, so it stays an environment variable.
JOBPOCKET_BOOKING_SLUG=coastpro

# Where JobPocket lives. Leave unset in production — the default is correct.
JOBPOCKET_API_BASE=

# The plugin key that lets this site file leads and read back their outcome.
# Normally NOT set here: it belongs in the `settings` table, pasted from
# JobPocket's builder screen, because the key rotates and a rotation would
# otherwise need a redeploy before the forms worked again. Set it only for
# local work — the environment wins over the table when present.
JOBPOCKET_API_KEY=

# Reads the booking inbox and the calendar, and accepts requests into jobs.
# A third key on purpose: the website key can only file leads, so if it leaks
# out of the public site nobody gets the schedule. Normally NOT set here —
# paste it on the Settings screen, where it is sealed before it is stored.
JOBPOCKET_OPERATIONS_KEY=

# --- Call tracking (Telnyx) ---------------------------------------------------

# Telnyx portal → Account → Keys → Public Key. Verifies the call webhook.
TELNYX_PUBLIC_KEY=
# Alternative to the public key while testing: append ?token=... to the webhook
# URL and put the same value here.
TELNYX_WEBHOOK_TOKEN=

# --- Reporting conversions back to the ad platforms ---------------------------

# Google Ads offline conversion import. The conversion action must be created in
# Google Ads first, with "Import → from clicks".
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CONVERSION_ACTION_ID=

# Meta Conversions API — Events Manager → Settings → Generate access token.
META_PIXEL_ID=
META_CAPI_TOKEN=

# --- Scheduled jobs -----------------------------------------------------------

# Protects /api/cron/conversions. Vercel sends it as a bearer token
# automatically once the variable exists.
CRON_SECRET=

# --- Existing integrations ----------------------------------------------------

NEXT_PUBLIC_CRISP_WEBSITE_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-W9Q0EMD7Q5

# ---------------------------------------------------------------------------
# Presence — the listings and profiles the business appears on
#
# Only the application ids live here now. The accounts themselves are attached
# with the Connect buttons on /admin/presence, and what that produces — refresh
# tokens, page tokens, location ids — is kept in the database. A token in an env
# var can only be replaced by editing the project and redeploying, and these are
# exactly the credentials that lapse.
#
# Google Business Profile. Separate from the Google Ads credentials above: this
# needs the business.manage scope, and sharing a refresh token between them
# means one revocation takes out both. Register the redirect URI as
# https://coastpro.us/api/admin/presence/connect/google/callback
#
# The Business Profile APIs also need enabling on a Cloud project and an access
# request approved by Google, which has historically taken days to weeks. Until
# that lands, Connect signs in and then reports the APIs are not enabled yet.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=

# Meta — Instagram and Facebook insights. Register the redirect URI as
# https://coastpro.us/api/admin/presence/connect/meta/callback
#
# Instagram is reached through the Facebook Page it is linked to, so connecting
# the Page is what connects both. The callback exchanges the short-lived token
# for a long-lived one before deriving the Page token, which is what stops it
# expiring every sixty days.
META_APP_ID=
META_APP_SECRET=

# Set before the Connect buttons existed; still honoured so nothing that was
# already working stops. Leave blank on a new setup.
GBP_REFRESH_TOKEN=
GBP_LOCATION_ID=
META_PAGE_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# Yelp and Apple Business Connect have no API a single location can use — their
# numbers are typed into /admin/presence by hand. Nothing to configure.
